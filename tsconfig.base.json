{
	"compileOnSave": false,
	"compilerOptions": {
		"rootDir": ".",
		"sourceMap": true,
		"declaration": false,
		"moduleResolution": "node",
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"importHelpers": true,
		"target": "es2015",
		"module": "esnext",
		"lib": ["es2017", "dom"],
		"skipLibCheck": true,
		"skipDefaultLibCheck": true,
		"baseUrl": ".",
		"noImplicitAny": true,
		"paths": {
			"@apps/*": ["apps/*"],
			"@nx-next-app/components/*": ["libs/web/src/components/*"],
			"@nx-next-app/constants": ["libs/web/src/app/constants"],
			"@nx-next-app/data-access": ["libs/web/src/data-access"],
			"@nx-next-app/features/*": ["libs/features/src/lib/*"],
			"@nx-next-app/hooks": ["libs/web/src/hooks"],
			"@nx-next-app/middleware": ["libs/web/src/siteMiddleware.ts"],
			"@nx-next-app/operations": ["libs/operations/src/index.tsx"],
			"@nx-next-app/service": ["libs/web/src/service"],
			"@nx-next-app/site/*": ["libs/web/src/app/site/*"],
			"@nx-next-app/store": ["libs/web/src/app/store"],
			"@nx-next-app/types": ["libs/web/src/app/types"],
			"@nx-next-app/utils": ["libs/web/src/utils"],

			"@n88-desktop/components/*": ["apps/nova88-desktop/components/*"],
			"@n88-h5/components/*": ["apps/nova88-h5/components/*"],

			"@yashbet-desktop/components/*": ["apps/yashbet-desktop/components/*"],
			"@yashbet-h5/components/*": ["apps/yashbet-h5/components/*"],

			"@nova88-desktop/providers": ["apps/nova88-desktop/providers"],
			"@nova88-h5/providers": ["apps/nova88-h5/providers"],
			"@nova88-desktop/components": ["apps/nova88-desktop/components"],
			"@nova88-h5/components": ["apps/nova88-h5/components"],
			"@12b-desktop/components/*": ["apps/onetwobet-desktop/components/*"],
			"@12b-h5/components/*": ["apps/onetwobet-h5/components/*"],
			"@12b-indo-desktop/components/*": [
				"apps/onetwobet-indo-desktop/components/*"
			],
			"@12b-indo-h5/components/*": ["apps/onetwobet-indo-h5/components/*"]
		},
		"jsx": "react"
	},
	"exclude": ["node_modules", "tmp"]
}
