FROM hub.lumigame.com/base/node:18-16-alpine-24h1.1 AS builder

# alpine 輕量化 Image 不包含必要的 python 資源，需另外加載才可正確執行 npm 安裝指令
RUN apk add --no-cache libc6-compat python3 make g++

ARG TRANSFORM_CONFIG

WORKDIR /build

# bind node_modules to bin/PATH
# 因為有用到 node_module內的 nx command
# 故需要綁定 docker bin path 否則會 command not found
ENV PATH /build/node_modules/.bin:$PATH
COPY . .
# copy env
COPY ./apps/nova88-desktop/.env.${TRANSFORM_CONFIG} ./apps/nova88-desktop/.env

# install
RUN npm ci
RUN nx clear-cache
RUN app=nova88-desktop npm run build

FROM hub.lumigame.com/base/node:18-16-alpine-24h1.1 AS serve-step

ARG port
WORKDIR /app

# 指定 group 和使用者
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# 將檔案綁定至 group 與使用者
COPY --from=builder --chown=nextjs:nodejs /build/dist/apps/nova88-desktop/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /build/dist/apps/nova88-desktop/.next/static ./dist/apps/nova88-desktop/.next/static
COPY --from=builder --chown=nextjs:nodejs /build/dist/apps/nova88-desktop/public ./apps/nova88-desktop/public

USER nextjs

# server.js 運行路徑
ENV APP_PATH=apps/nova88-desktop/server.js
EXPOSE 5000
ENV PORT 5000

CMD node $APP_PATH


