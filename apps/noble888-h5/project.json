{
	"name": "noble888-h5",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "apps/noble888-h5",
	"projectType": "application",
	"targets": {
		"build": {
			"executor": "@nrwl/next:build",
			"outputs": ["{options.outputPath}"],
			"defaultConfiguration": "production",
			"options": {
				"root": "apps/noble888-h5",
				"outputPath": "dist/apps/noble888-h5"
			},
			"configurations": {
				"development": {
					"outputPath": "apps/noble888-h5"
				},
				"production": {}
			}
		},
		"serve": {
			"executor": "@nrwl/next:server",
			"defaultConfiguration": "development",
			"options": {
				"buildTarget": "noble888-h5:build",
				"dev": true,
				"port": 3007
			},
			"configurations": {
				"development": {
					"buildTarget": "noble888-h5:build:development",
					"dev": true
				},
				"production": {
					"buildTarget": "noble888-h5:build:production",
					"dev": false
				}
			}
		},
		"export": {
			"executor": "@nrwl/next:export",
			"options": {
				"buildTarget": "noble888-h5:build:production"
			}
		},
		"test": {
			"executor": "@nrwl/jest:jest",
			"outputs": ["coverage/apps/noble888-h5"],
			"options": {
				"jestConfig": "apps/noble888-h5/jest.config.ts",
				"passWithNoTests": true
			}
		},
		"lint": {
			"executor": "@nrwl/linter:eslint",
			"outputs": ["{options.outputFile}"],
			"options": {
				"lintFilePatterns": ["apps/noble888-h5/**/*.{ts,tsx,js,jsx}"]
			}
		}
	},
	"tags": []
}
