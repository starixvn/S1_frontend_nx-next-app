pipeline {
    agent none
    environment {
        env = 'dev'
        registry = '13.213.82.69/mobile/next-nova88-dev'
        ansible_path = '/var/jenkins_home/ansible/frontend'
        project = 'nova88-h5'
        project_port = '5074'
    }
    stages {
        stage('Build') {
            agent { node { label 'Build' } }
            steps {
                script {
                    env.version = sh (script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                }
                sh 'sudo docker build --build-arg project_name=${project} --build-arg port=${project_port} --build-arg env=${env} -t ${registry}:${version} .'
                sh 'sudo docker login 13.213.82.69 -u jenkins -p 06ftJ0Ds'
                sh 'sudo docker push ${registry}:${version}'
                sh 'sudo docker rmi ${registry}:${version}'
            }
        }
        stage('Deploy') {
            agent { node { label 'master' } }
            steps {
                sh 'ansible-playbook -i ${ansible_path}/DEV.AWS.yml ${ansible_path}/deploy.docker.yml --extra-vars "host=linux-dev docker_name=next-sample-dev ver=mobile/next-nova88-dev:${version} env=${env} docker_ports=${project_port}:${project_port}"'
            }
        }
    }
}
